modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm --filter @workspace/api-spec run codegen && pnpm --filter @workspace/mtos-crm run build && pnpm --filter @workspace/api-server run build"]
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/server/index.mjs"]

[deployment.env]
NODE_ENV = "production"
PORT = "8080"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }


[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MTOS Worker: Job Processor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rbac-route-matrix"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "db-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rbac-test"

[[workflows.workflow]]
name = "MTOS Worker: Job Processor"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev:worker"

[[workflows.workflow]]
name = "rbac-route-matrix"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-rbac-route-matrix.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "db-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run drift"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "rbac-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --import tsx --test src/lib/__tests__/rbac.test.ts src/lib/__tests__/rbac-route-matrix.test.ts src/lib/__tests__/rbac-route-matrix-headline.test.ts src/lib/__tests__/firm-context.test.ts src/lib/__tests__/firm-invites.test.ts src/routes/__tests__/vapi-tools-eligibility-mapping.test.ts src/routes/__tests__/leads-fax-results-route.test.ts src/routes/__tests__/auth-register-route.test.ts src/routes/__tests__/users-route.test.ts"

[workflows.workflow.metadata]
isValidation = true

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 24540
externalPort = 3000

[agent]
expertMode = true
