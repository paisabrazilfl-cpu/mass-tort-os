modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MTOS Worker: Job Processor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rbac-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rbac-route-matrix"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "db-drift"

[[workflows.workflow]]
name = "MTOS Worker: Job Processor"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev:worker"

[[workflows.workflow]]
name = "rbac-test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --import tsx --test src/lib/__tests__/rbac.test.ts src/lib/__tests__/rbac-route-matrix.test.ts src/lib/__tests__/rbac-route-matrix-headline.test.ts"

[[workflows.workflow]]
name = "rbac-route-matrix"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-rbac-route-matrix.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "db-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run drift"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 5000

[[ports]]
localPort = 9999
externalPort = 4200
exposeLocalhost = true

[[ports]]
localPort = 18099
externalPort = 3002

[[ports]]
localPort = 24540
externalPort = 3000

[[ports]]
localPort = 24541
externalPort = 3001

[[ports]]
localPort = 24542
externalPort = 5173

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ENCRYPTION_KEY = "32a6446807d6701f0646e6c6d79642ad66720fcd68bfc42cc14fa5c4835a6e1a"
