FROM mirror.gcr.io/library/node:22-slim
WORKDIR /app
ENV NODE_ENV=production

COPY node_modules ./node_modules
COPY artifacts/api-server/dist ./artifacts/api-server/dist
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY docs ./docs
COPY package.json ./
COPY lib/db ./lib/db

EXPOSE 8080
# Default CMD for the "app" process group (API server).
# The "worker" process group overrides this via fly.toml [processes].
CMD ["node", "--enable-source-maps", "artifacts/api-server/dist/server/index.mjs"]
