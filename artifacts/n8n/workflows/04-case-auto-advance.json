{
  "name": "MTOS — Case auto-advance when worker finishes processing docs",
  "_description": "When the analyze_case worker emits case.stage_changed (typically to `analyzed`, which fires after every fresh document the case picks up), this workflow GETs the case, counts attached documents against MTOS_REQUIRED_DOC_COUNT (default 3), and — if the threshold is met and the case isn't already past it — advances the case to `documents_received` via PATCH /api/cases/:id/status. We trigger off case.stage_changed (not ocr.completed) because that event already carries case_id; the leads schema does not record a case_id back-reference, so an ocr.completed → lead → case lookup is impossible without a schema migration. Subscribe to event: case.stage_changed. Required scopes: cases:read, cases:write.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mtos-case-stage-changed-advance",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh",
      "name": "MTOS case.stage_changed webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "combinator": "and",
          "conditions": [
            { "id": "c-id",     "operator": { "type": "string",  "operation": "notEmpty" }, "leftValue": "={{ $json.case_id }}" },
            { "id": "c-stage",  "operator": { "type": "string",  "operation": "equals"   }, "leftValue": "={{ $json.new_status }}", "rightValue": "analyzed" }
          ]
        }
      },
      "id": "if-trigger",
      "name": "Only on transition into `analyzed`",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MTOS_API_BASE }}/api/cases/{{ $json.case_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "get-case",
      "name": "GET /cases/:id (with documents)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "credentials": { "httpHeaderAuth": { "id": "mtos-api-key", "name": "MTOS API Key (cases:read,cases:write)" } },
      "position": [680, 220]
    },
    {
      "parameters": {
        "jsCode": "// Required-doc check. Each firm tunes the bar via\n// MTOS_REQUIRED_DOC_COUNT (default 3 — typically intake form +\n// retainer + at least one medical record). When met, advance the\n// case to `documents_received`. Don't bounce backwards if it's\n// already past this stage.\nconst caseRow = $json;\nconst ctx = $('MTOS case.stage_changed webhook').item.json;\nconst docs = Array.isArray(caseRow.documents) ? caseRow.documents : (caseRow.case_documents || []);\nconst required = Number($env.MTOS_REQUIRED_DOC_COUNT || 3);\nconst docCount = docs.length;\nif (docCount < required) {\n  return [{ json: { advance: false, case_id: ctx.case_id, doc_count: docCount, required, reason: 'threshold_not_met' } }];\n}\nconst current = (caseRow.status || '').toLowerCase();\nconst alreadyAdvanced = ['documents_received','ready_for_review','client_signed','filed','closed'].includes(current);\nif (alreadyAdvanced) {\n  return [{ json: { advance: false, case_id: ctx.case_id, doc_count: docCount, required, reason: `already at ${current}` } }];\n}\nreturn [{ json: { advance: true, case_id: ctx.case_id, doc_count: docCount, required, current_status: current } }];"
      },
      "id": "decide",
      "name": "Required-doc threshold met?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "combinator": "and",
          "conditions": [
            { "id": "c-adv", "operator": { "type": "boolean", "operation": "true" }, "leftValue": "={{ $json.advance }}" }
          ]
        }
      },
      "id": "if-advance",
      "name": "If threshold met",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1160, 220]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.MTOS_API_BASE }}/api/cases/{{ $json.case_id }}/status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"documents_received\",\n  \"reason\": \"auto-advance: {{ $json.doc_count }}/{{ $json.required }} required documents received\"\n}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "advance",
      "name": "PATCH /cases/:id/status (documents_received)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "credentials": { "httpHeaderAuth": { "id": "mtos-api-key", "name": "MTOS API Key (cases:read,cases:write)" } },
      "position": [1400, 140]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={ \"ok\": true, \"action\": \"advanced\", \"case_id\": $json.case_id }" },
      "id": "ok-adv",
      "name": "Respond — advanced",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1640, 140]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={ \"ok\": true, \"action\": \"noop\" }" },
      "id": "ok-noop",
      "name": "Respond — noop",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1400, 360]
    }
  ],
  "connections": {
    "MTOS case.stage_changed webhook": { "main": [[{ "node": "Only on transition into `analyzed`", "type": "main", "index": 0 }]] },
    "Only on transition into `analyzed`": { "main": [
      [{ "node": "GET /cases/:id (with documents)", "type": "main", "index": 0 }],
      [{ "node": "Respond — noop", "type": "main", "index": 0 }]
    ] },
    "GET /cases/:id (with documents)": { "main": [[{ "node": "Required-doc threshold met?", "type": "main", "index": 0 }]] },
    "Required-doc threshold met?": { "main": [[{ "node": "If threshold met", "type": "main", "index": 0 }]] },
    "If threshold met": { "main": [
      [{ "node": "PATCH /cases/:id/status (documents_received)", "type": "main", "index": 0 }],
      [{ "node": "Respond — noop", "type": "main", "index": 0 }]
    ] },
    "PATCH /cases/:id/status (documents_received)": { "main": [[{ "node": "Respond — advanced", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
