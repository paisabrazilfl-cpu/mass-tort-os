{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build:server && pnpm run start",
    "dev:worker": "export NODE_ENV=development && pnpm run build:worker && pnpm run worker",
    "build": "node ./build.mjs all",
    "build:server": "node ./build.mjs server",
    "build:worker": "node ./build.mjs worker",
    "start": "node --enable-source-maps ./dist/server/index.mjs",
    "worker": "node --enable-source-maps ./dist/worker/worker.mjs",
    "pretypecheck": "tsc -b ../../",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-timeout=30000 src/lib/__tests__/*.test.ts",
    "verify:search": "tsx src/scripts/verify-serpapi.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "smoke:http": "tsx src/scripts/smoke-http.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@types/pdf-parse": "^1.1.5",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "sharp": "^0.34.5",
    "stripe": "^22.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
