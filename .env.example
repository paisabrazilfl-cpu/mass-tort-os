# Mass Tort OS — environment variables.
#
# Set every REQUIRED value on Railway (or wherever the service runs) before
# the first deploy. The boot path fail-closes on missing required values in
# production / staging — the API server refuses to start if anything is missing.
#
# OPTIONAL keys enable specific integrations. The CRM works without them but
# the corresponding feature returns a "not configured" error to the operator.

# ─── REQUIRED — API server ─────────────────────────────────────────────────────

# PostgreSQL connection string. Railway auto-provides this when you attach
# the Postgres plugin to the service. Format:
#   postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# 64-char hex / 44-char base64 secret used to sign JWT access + refresh tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM column-encryption key (32 bytes). Used to encrypt SSN, DOB,
# phone, address, email at rest on the leads table.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_V1=

# Node runtime mode. Must be "production" on Railway.
NODE_ENV=production

# Port the server binds to. Railway injects this automatically — leave unset
# locally for the default (3000).
# PORT=8080

# ─── REQUIRED — SPA frontend (mtos-crm) ───────────────────────────────────────

# Path the SPA is served under. Use "/" unless you're behind a path-prefix
# reverse proxy.
BASE_PATH=/

# Public URL of the API server. The SPA's apiFetch wrapper prepends this to
# /api/... calls. Leave unset and the SPA will call same-origin (only works
# if you're serving the SPA from the API server).
# VITE_API_BASE_URL=https://api.mtos.example.com

# ─── OPTIONAL — LLM providers ──────────────────────────────────────────────────

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opt into AI Resiliency v2 (per-provider circuit breaker, error classifier,
# observer, per-attempt timeout). Default off. Set to literal "1" to enable.
AI_RESILIENCY_V2=

# ─── OPTIONAL — integrations stored in the vault ──────────────────────────────
# These do NOT need to live in env. The recommended path is to add them via
# /api/admin/integrations after first boot — they live encrypted in the
# `integrations` table. Set them here only if you want a hardcoded fallback.

# Email (SendGrid / SMTP)
# SENDGRID_API_KEY=

# Fax (SRFax / Telnyx Fax)
# SRFAX_ACCESS_ID=
# SRFAX_ACCESS_PASSWORD=

# SMS / Voice (Telnyx)
# TELNYX_API_KEY=
# TELNYX_PUBLIC_KEY=

# E-sign (DocuSign / Dropbox Sign)
# DOCUSIGN_ACCESS_TOKEN=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_API_URL=https://na4.docusign.net/restapi   # ← MUST point at production, not demo.docusign.net

# Search / Ads intelligence
# SERPAPI_KEY=

# Background check
# GARBO_API_KEY=

# Billing (Stripe — production secret + webhook signing secret)
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── OPTIONAL — runtime behavior ───────────────────────────────────────────────

# Run the background worker in-process with the API. The default when
# NODE_ENV=production is "yes" — set to "0" to disable (e.g. when running
# the worker as a separate Railway service).
# INPROC_WORKER=1

# Verbose verification-link logging in development. Hard-disabled in
# production regardless of value.
# MTOS_LOG_VERIFICATION_LINK=0

# Dev-only auth bypass. NEVER set this in production.
# MTOS_DEV_LOGIN=0
